# Roomora AI — environment variables
#
# Copy this file to .env and fill in your own values.
# NEVER commit .env — it is listed in .gitignore.
# The Telegraph key must stay on the backend only; never expose it to the frontend.

# ---------------------------------------------------------------------------
# App (section 6)
# ---------------------------------------------------------------------------
APP_NAME=roomora-ai
DEBUG=true

# Mode switch: "mock" (Phase 1 — no real API calls) or "real" (Phase 2)
ROOMORA_MODE=mock

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./roomora.db

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_MB=8

# ---------------------------------------------------------------------------
# Telegraph  — backend only, never sent to the frontend
# ---------------------------------------------------------------------------
TELEGRAPH_API_URL=https://backend.telegraphprotocol.com/agent/chat
TELEGRAPH_BEARER_KEY=your-telegraph-bearer-key-here
TELEGRAPH_NETWORK=sepolia
# Maximum USD the agent may spend per Telegraph call (safety cap)
TELEGRAPH_MAX_SPEND_USD=1.0

# ---------------------------------------------------------------------------
# OpenRouter  — vision model + image generation (Phase 2)
# ---------------------------------------------------------------------------
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ---------------------------------------------------------------------------
# Currency
# ---------------------------------------------------------------------------
DEFAULT_CURRENCY=INR

# ---------------------------------------------------------------------------
# Frontend (Vite)  — set in frontend/.env if you deploy to a non-default URL
# ---------------------------------------------------------------------------
# VITE_API_URL=http://localhost:8000
