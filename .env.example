# Roomora AI — environment variables
#
# Copy this file to .env and fill in your own values.
# NEVER commit .env — it is listed in .gitignore.
# The Telegraph key must stay on the backend only; never expose it to the frontend.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=roomora-ai
DEBUG=true

# ---------------------------------------------------------------------------
# Mode switches (section 6) — independent per service
# "mock" means Phase 1 placeholders; no keys needed.
# ---------------------------------------------------------------------------
VISION_MODE=mock            # mock | openrouter
PRICING_MODE=mock           # mock | telegraph

# ---------------------------------------------------------------------------
# Database — path relative to the backend/ working directory
# ---------------------------------------------------------------------------
DB_PATH=roomora.db

# ---------------------------------------------------------------------------
# Uploads — path relative to the backend/ working directory
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ---------------------------------------------------------------------------
# Telegraph  — backend only, never sent to the frontend (section 7)
# ---------------------------------------------------------------------------
TELEGRAPH_API_URL=https://backend.telegraphprotocol.com/agent/chat
TELEGRAPH_API_KEY=your-telegraph-api-key-here
TELEGRAPH_NETWORK=sepolia-testnet

# Safety caps (section 6, section 7 rules 1 & 2)
TELEGRAPH_MAX_SPEND_USD_PER_CALL=0.05
TELEGRAPH_SESSION_CAP_USD=0.50

# ---------------------------------------------------------------------------
# OpenRouter  — vision model (Phase 3)
# ---------------------------------------------------------------------------
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free

# ---------------------------------------------------------------------------
# Frontend (Vite) — set in frontend/.env if you deploy to a non-default URL
# ---------------------------------------------------------------------------
# VITE_API_URL=http://localhost:8000
